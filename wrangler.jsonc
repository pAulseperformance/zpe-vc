{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zpe-vc",
  "compatibility_date": "2024-03-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "main": "src/worker.ts",
  "routes": [
    {
      "pattern": "zpe.vc",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "FORGE_LOG",
      "id": "cd612b74d74c4e2dbc6ca71d91862629"
    }
  ]
}
