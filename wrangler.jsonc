{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zpe-vc",
  "compatibility_date": "2024-03-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "zpe.vc",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
