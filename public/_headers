# Prevent caching of HTML entry point so deploys take effect immediately
/
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache

# Hashed asset files can be cached forever (Vite content-hashes them)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
